{
  "expo": {
    "name": "ADLAWATT-",
    "slug": "ADLAWATT-",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/adlawatt-logo.png",
    "scheme": "adlawatt",
    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": "./assets/images/adlawatt-logo.png",
      "bundleIdentifier": "com.teamadlawatt.ADLAWATT",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/adlawatt-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.teamadlawatt.ADLAWATT"
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/adlawatt-logo.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "ba375929-16f4-4a21-b339-8b43e93ecfd2"
      }
    }
  }
}