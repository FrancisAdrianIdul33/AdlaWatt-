-- ============================================
-- ADLAWATT USERS + APPLIANCES
-- ============================================
-- auth.users
--      ↓
-- handle_new_user()
--      ↓
-- public.users
--      ↓
-- user's appliance catalog
--
-- Password is stored ONLY in auth.users.
-- Every appliance belongs to a specific user.
-- RLS prevents users from accessing other users'
-- appliance records.
-- ============================================


-- ============================================
-- 1. REMOVE EXISTING USER TRIGGER/FUNCTION
-- ============================================

drop trigger if exists on_auth_user_created on auth.users;

drop function if exists public.handle_new_user();


-- ============================================
-- 2. REMOVE EXISTING APPLIANCES TABLE
-- ============================================

drop table if exists public.appliances cascade;


-- ============================================
-- 3. CREATE APPLIANCES TABLE
-- ============================================

create table public.appliances (

    -- Unique appliance record
    app_id uuid primary key default gen_random_uuid(),

    -- Owner of the appliance
    user_id uuid not null
        references public.users(id)
        on delete cascade,

    -- Appliance name
    appliance_name text not null,

    -- Example: 30-50W
    wattage text not null,

    -- User selection
    selection boolean not null default false,

    -- House area
    area text not null,

    -- catalog = AdlaWatt appliance
    -- custom  = user-created appliance
    type text not null default 'catalog',

    -- true = advisable
    -- false = not advisable
    status boolean not null default true,

    -- Creation timestamp
    created_at timestamptz not null default now()

);


-- ============================================
-- 4. APPLIANCE CONSTRAINTS
-- ============================================

alter table public.appliances
    add constraint appliances_type_check
    check (type in ('catalog', 'custom'));

alter table public.appliances
    add constraint appliances_name_check
    check (char_length(trim(appliance_name)) > 0);

alter table public.appliances
    add constraint appliances_wattage_check
    check (char_length(trim(wattage)) > 0);


-- ============================================
-- 5. APPLIANCE INDEXES
-- ============================================

create index appliances_user_id_idx
on public.appliances(user_id);

create index appliances_user_selection_idx
on public.appliances(user_id, selection);

create index appliances_user_area_idx
on public.appliances(user_id, area);


-- ============================================
-- 6. ENABLE APPLIANCE RLS
-- ============================================

alter table public.appliances
    enable row level security;


-- ============================================
-- 7. APPLIANCE RLS POLICIES
-- ============================================

create policy "Users can view own appliances"
on public.appliances
for select
to authenticated
using (
    auth.uid() = user_id
);


create policy "Users can create own appliances"
on public.appliances
for insert
to authenticated
with check (
    auth.uid() = user_id
);


create policy "Users can update own appliances"
on public.appliances
for update
to authenticated
using (
    auth.uid() = user_id
)
with check (
    auth.uid() = user_id
);


create policy "Users can delete own appliances"
on public.appliances
for delete
to authenticated
using (
    auth.uid() = user_id
);


-- ============================================
-- 8. CREATE NEW USER FUNCTION
-- ============================================
-- This function:
--
-- 1. Reads username and terms_agreed from
--    Supabase Auth metadata.
--
-- 2. Creates public.users.
--
-- 3. Creates the user's complete appliance
--    catalog automatically.
--
-- This runs whenever a new auth.users row
-- is created.
-- ============================================

create or replace function public.handle_new_user()
returns trigger
language plpgsql
security definer
set search_path = public
as $$

declare
    new_username text;
    new_terms_agreed boolean;

begin

    -- ----------------------------------------
    -- Get username
    -- ----------------------------------------

    new_username :=
        nullif(
            trim(new.raw_user_meta_data->>'username'),
            ''
        );


    -- ----------------------------------------
    -- Get Terms agreement
    -- ----------------------------------------

    new_terms_agreed :=
        coalesce(
            (new.raw_user_meta_data->>'terms_agreed')::boolean,
            false
        );


    -- ----------------------------------------
    -- Validate username
    -- ----------------------------------------

    if new_username is null then
        raise exception 'Username is required.';
    end if;


    if char_length(new_username) < 3
       or char_length(new_username) > 30 then

        raise exception
            'Username must be between 3 and 30 characters.';

    end if;


    if new_username !~ '^[a-zA-Z0-9_]+$' then

        raise exception
            'Username can only contain letters, numbers, and underscores.';

    end if;


    -- ----------------------------------------
    -- Validate Terms and Conditions
    -- ----------------------------------------

    if new_terms_agreed is not true then

        raise exception
            'Terms and Conditions must be accepted.';

    end if;


    -- ========================================
    -- CREATE PUBLIC USER PROFILE
    -- ========================================

    insert into public.users (
        id,
        username,
        email,
        terms_agreed
    )
    values (
        new.id,
        new_username,
        lower(trim(new.email)),
        new_terms_agreed
    );


    -- ========================================
    -- CREATE USER APPLIANCE CATALOG
    -- ========================================
    -- Every new user receives their own
    -- independent copy of the catalog.
    -- ========================================

    insert into public.appliances (
        user_id,
        appliance_name,
        wattage,
        selection,
        area,
        type,
        status
    )

    select
        new.id,
        catalog.appliance_name,
        catalog.wattage,
        false,
        catalog.area,
        'catalog',
        true

    from (
        values

            -- --------------------------------
            -- Living Area
            -- --------------------------------

            ('Stand Fan', '35-75W', 'Living Area'),
            ('LED Smart TV', '30-75W', 'Living Area'),
            ('Wi-Fi Router', '10-20W', 'Living Area'),
            ('Digital TV Box', '5-15W', 'Living Area'),
            ('Bluetooth Speaker', '10-40W', 'Living Area'),
            ('Air Purifier', '25-60W', 'Living Area'),
            ('LED Ceiling Light', '7-15W', 'Living Area'),

            -- --------------------------------
            -- Bedroom
            -- --------------------------------

            ('Wall Fan', '25-50W', 'Bedroom'),
            ('Clip Fan', '15-30W', 'Bedroom'),
            ('Phone Charger', '10-30W', 'Bedroom'),
            ('Tablet Charger', '10-20W', 'Bedroom'),
            ('Emergency Light', '5-15W', 'Bedroom'),
            ('Insect Swatter', '2-5W', 'Bedroom'),
            ('LED Night Light', '1-5W', 'Bedroom'),
            ('CPAP Machine', '30-60W', 'Bedroom'),

            -- --------------------------------
            -- Kitchen & Dining Area
            -- --------------------------------

            ('Mini Inverter Refrigerator', '50-120W', 'Kitchen & Dining Area'),
            ('Water Dispenser', '50-80W', 'Kitchen & Dining Area'),
            ('Exhaust Fan', '20-45W', 'Kitchen & Dining Area'),
            ('Electric Can Opener', '50-90W', 'Kitchen & Dining Area'),
            ('LED Bulb', '9-18W', 'Kitchen & Dining Area'),

            -- --------------------------------
            -- Work & Study Area
            -- --------------------------------

            ('Laptop Charger', '45-65W', 'Work & Study Area'),
            ('USB Desk Fan', '5-15W', 'Work & Study Area'),
            ('LED Desk Lamp', '5-12W', 'Work & Study Area'),
            ('Inkjet Printer', '15-40W', 'Work & Study Area'),
            ('Computer Monitor', '15-45W', 'Work & Study Area'),
            ('Wi-Fi Extender', '5-12W', 'Work & Study Area'),

            -- --------------------------------
            -- Bathroom & Laundry Area
            -- --------------------------------

            ('Rechargeable Trimmer', '5-10W', 'Bathroom & Laundry Area'),
            ('Electric Toothbrush Charger', '2-5W', 'Bathroom & Laundry Area'),
            ('Water Flosser', '10-20W', 'Bathroom & Laundry Area'),
            ('Small Exhaust Fan', '15-30W', 'Bathroom & Laundry Area'),
            ('Bathroom LED Bulb', '5-12W', 'Bathroom & Laundry Area'),

            -- --------------------------------
            -- Porch & Yard
            -- --------------------------------

            ('Outdoor LED Bulb', '10-20W', 'Porch & Yard'),
            ('CCTV Camera', '5-12W', 'Porch & Yard'),
            ('Rechargeable Lantern', '5-15W', 'Porch & Yard')

    ) as catalog(
        appliance_name,
        wattage,
        area
    );


    return new;

end;
$$;


-- ============================================
-- 9. CREATE AUTH -> PUBLIC USER TRIGGER
-- ============================================

create trigger on_auth_user_created
after insert on auth.users
for each row
execute function public.handle_new_user();


-- ============================================
-- 10. BACKFILL EXISTING USERS
-- ============================================
-- Existing users do not trigger
-- handle_new_user() again.
--
-- This section gives existing users their
-- appliance catalog once.
-- ============================================

insert into public.appliances (
    user_id,
    appliance_name,
    wattage,
    selection,
    area,
    type,
    status
)

select
    u.id,
    catalog.appliance_name,
    catalog.wattage,
    false,
    catalog.area,
    'catalog',
    true

from public.users u

cross join (
    values

        ('Stand Fan', '35-75W', 'Living Area'),
        ('LED Smart TV', '30-75W', 'Living Area'),
        ('Wi-Fi Router', '10-20W', 'Living Area'),
        ('Digital TV Box', '5-15W', 'Living Area'),
        ('Bluetooth Speaker', '10-40W', 'Living Area'),
        ('Air Purifier', '25-60W', 'Living Area'),
        ('LED Ceiling Light', '7-15W', 'Living Area'),

        ('Wall Fan', '25-50W', 'Bedroom'),
        ('Clip Fan', '15-30W', 'Bedroom'),
        ('Phone Charger', '10-30W', 'Bedroom'),
        ('Tablet Charger', '10-20W', 'Bedroom'),
        ('Emergency Light', '5-15W', 'Bedroom'),
        ('Insect Swatter', '2-5W', 'Bedroom'),
        ('LED Night Light', '1-5W', 'Bedroom'),
        ('CPAP Machine', '30-60W', 'Bedroom'),

        ('Mini Inverter Refrigerator', '50-120W', 'Kitchen & Dining Area'),
        ('Water Dispenser', '50-80W', 'Kitchen & Dining Area'),
        ('Exhaust Fan', '20-45W', 'Kitchen & Dining Area'),
        ('Electric Can Opener', '50-90W', 'Kitchen & Dining Area'),
        ('LED Bulb', '9-18W', 'Kitchen & Dining Area'),

        ('Laptop Charger', '45-65W', 'Work & Study Area'),
        ('USB Desk Fan', '5-15W', 'Work & Study Area'),
        ('LED Desk Lamp', '5-12W', 'Work & Study Area'),
        ('Inkjet Printer', '15-40W', 'Work & Study Area'),
        ('Computer Monitor', '15-45W', 'Work & Study Area'),
        ('Wi-Fi Extender', '5-12W', 'Work & Study Area'),

        ('Rechargeable Trimmer', '5-10W', 'Bathroom & Laundry Area'),
        ('Electric Toothbrush Charger', '2-5W', 'Bathroom & Laundry Area'),
        ('Water Flosser', '10-20W', 'Bathroom & Laundry Area'),
        ('Small Exhaust Fan', '15-30W', 'Bathroom & Laundry Area'),
        ('Bathroom LED Bulb', '5-12W', 'Bathroom & Laundry Area'),

        ('Outdoor LED Bulb', '10-20W', 'Porch & Yard'),
        ('CCTV Camera', '5-12W', 'Porch & Yard'),
        ('Rechargeable Lantern', '5-15W', 'Porch & Yard')

) as catalog(
    appliance_name,
    wattage,
    area
)

where not exists (
    select 1
    from public.appliances a
    where a.user_id = u.id
      and a.appliance_name = catalog.appliance_name
      and a.type = 'catalog'
);


