-- ============================================
-- Username Login Lookup
-- ============================================
-- Allows the login process to find the email
-- associated with a username before authentication.
-- Does not expose the users table directly.
-- ============================================

create or replace function public.get_email_by_username(
    lookup_username text
)
returns text
language sql
security definer
set search_path = public
as $$
    select email
    from public.users
    where username = lower(trim(lookup_username))
    limit 1;
$$;

-- Allow unauthenticated users to call the function
grant execute
on function public.get_email_by_username(text)
to anon;

-- Authenticated users may also call it
grant execute
on function public.get_email_by_username(text)
to authenticated;