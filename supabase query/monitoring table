-- ============================================
-- 1. REMOVE OLD MONITORING DEPENDENCIES
-- ============================================

drop trigger if exists monitoring_updated_at
on public.monitoring;

drop trigger if exists on_public_user_created_monitoring
on public.users;

drop function if exists public.update_monitoring_timestamp();

drop function if exists public.handle_new_user_monitoring();

drop function if exists public.update_monitoring_from_hardware(
    bigint,
    numeric
);

drop function if exists public.update_monitoring_from_hardware(
    integer,
    numeric
);

drop table if exists public.monitoring cascade;


-- ============================================
-- 2. CREATE MONITORING TABLE
-- ============================================

create table public.monitoring (

    -- 100, 200, 300, 400, ...
    monitor_id bigint generated always as identity
        (start with 100 increment by 100)
        primary key,

    -- One monitoring row per user
    user_id uuid not null
        references public.users(id)
        on delete cascade
        unique,

    -- Battery percentage
    battery_level numeric(5,2) not null default 0,

    -- Battery operating state
    battery_status text not null default 'Idle',

    -- Estimated remaining runtime
    time_remaining text not null default '0h 00m',

    -- Current solar input
    solar_input numeric(10,2) not null default 0,

    -- Solar condition
    solar_status text not null default 'Low',

    -- Current system/appliance load
    current_load numeric(10,2) not null default 0,

    -- ESP32/system status
    device_status text not null default 'Offline',

    -- Battery temperature
    battery_temperature numeric(5,2) not null default 0,

    -- Battery temperature condition
    battery_temperature_status text not null default 'Normal'
);


-- ============================================
-- 3. VALIDATION
-- ============================================

alter table public.monitoring
    add constraint monitoring_battery_level_check
    check (battery_level between 0 and 100);

alter table public.monitoring
    add constraint monitoring_battery_status_check
    check (
        battery_status in (
            'Charging',
            'Discharging',
            'Idle'
        )
    );

alter table public.monitoring
    add constraint monitoring_solar_input_check
    check (solar_input >= 0);

alter table public.monitoring
    add constraint monitoring_solar_status_check
    check (
        solar_status in (
            'Low',
            'Moderate',
            'High'
        )
    );

alter table public.monitoring
    add constraint monitoring_current_load_check
    check (current_load >= 0);

alter table public.monitoring
    add constraint monitoring_device_status_check
    check (
        device_status in (
            'Online',
            'Offline'
        )
    );

alter table public.monitoring
    add constraint monitoring_temperature_status_check
    check (
        battery_temperature_status in (
            'Normal',
            'Moderate',
            'Alarming'
        )
    );

alter table public.monitoring
    add constraint monitoring_time_remaining_check
    check (
        char_length(trim(time_remaining)) > 0
    );


