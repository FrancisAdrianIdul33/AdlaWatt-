-- ============================================

create or replace function public.handle_new_user_monitoring()
returns trigger
language plpgsql
security definer
set search_path = public
as $$
begin

    insert into public.monitoring (
        user_id
    )
    values (
        new.id
    )
    on conflict (user_id) do nothing;

    return new;

end;
$$;


