-- ============================================
-- 8. VERIFY NOTIFICATIONS
-- ============================================

select
    notif_id,
    user_id,
    title,
    description,
    type,
    read,
    created_at
from public.notifications
order by created_at desc;


-- ============================================
-- 9. CHECK NOTIFICATION COUNT PER USER
-- ============================================

select
    user_id,
    count(*) as notification_count
from public.notifications
group by user_id
order by user_id;