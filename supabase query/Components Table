-- ============================================
-- ADLAWATT COMPONENTS TABLE
-- ============================================
-- Stores the hardware components for each user.
--
-- public.users.id = components.user_id
--
-- status:
--   true  = active / connected
--   false = inactive / not connected
--
-- Users can only VIEW their own components.
-- Component status can later be updated by
-- the ESP32/IoT backend.
-- ============================================


-- ============================================
-- 1. REMOVE EXISTING COMPONENT TRIGGER
-- ============================================

drop trigger if exists on_user_created_components
on public.users;


-- ============================================
-- 2. REMOVE EXISTING COMPONENT FUNCTION
-- ============================================

drop function if exists public.create_default_components();


-- ============================================
-- 3. REMOVE EXISTING COMPONENTS TABLE
-- ============================================

drop table if exists public.components cascade;


-- ============================================
-- 4. CREATE COMPONENTS TABLE
-- ============================================

create table public.components (

    -- Unique component record
    component_id uuid primary key default gen_random_uuid(),

    -- Owner of the component record
    user_id uuid not null
        references public.users(id)
        on delete cascade,

    -- Component name
    component_name text not null,

    -- true = active / connected
    -- false = inactive / not connected
    status boolean not null default false

);


-- ============================================
-- 5. CONSTRAINTS
-- ============================================

-- Prevent duplicate component names
-- for the same user.

alter table public.components
    add constraint components_user_name_unique
    unique (user_id, component_name);


-- Component name cannot be empty

alter table public.components
    add constraint components_name_check
    check (
        char_length(trim(component_name)) > 0
    );


-- ============================================
-- 6. INDEXES
-- ============================================

create index components_user_id_idx
on public.components(user_id);


-- ============================================
-- 7. ENABLE ROW LEVEL SECURITY
-- ============================================

alter table public.components
    enable row level security;


-- ============================================
-- 8. RLS POLICY
-- ============================================
-- Users can only view their own components.
-- ============================================

create policy "Users can view own components"
on public.components
for select
to authenticated
using (
    auth.uid() = user_id
);


-- ============================================
-- 9. DEFAULT COMPONENT CREATION FUNCTION
-- ============================================
-- Creates the 8 default components for a user.
-- Used for both new and existing users.
-- ============================================

create or replace function public.create_default_components(
    target_user_id uuid
)
returns void
language plpgsql
security definer
set search_path = public
as $$
begin

    insert into public.components (
        user_id,
        component_name,
        status
    )

    select
        target_user_id,
        component_name,
        false

    from (
        values
            ('DS18B20'),
            ('ESP32'),
            ('LCD2004 with I2C'),
            ('Buck Converter'),
            ('INA226 (Input)'),
            ('INA226 (Output)'),
            ('Relay Module 5V 1 Channel'),
            ('Voltage Sensor')
    ) as components(component_name)

    on conflict (
        user_id,
        component_name
    )
    do nothing;

end;
$$;


-- ============================================
-- 10. AUTOMATIC COMPONENT CREATION
-- ============================================
-- Runs after a public.users profile is created.
--
-- This works with your existing:
--
-- auth.users
--     ↓
-- handle_new_user()
--     ↓
-- public.users
--     ↓
-- create_default_components()
--     ↓
-- public.components
-- ============================================

create or replace function public.handle_new_user_components()
returns trigger
language plpgsql
security definer
set search_path = public
as $$
begin

    perform public.create_default_components(new.id);

    return new;

end;
$$;


create trigger on_user_created_components
after insert on public.users
for each row
execute function public.handle_new_user_components();


-- ============================================
-- 11. BACKFILL EXISTING USERS
-- ============================================
-- Gives all existing users their component
-- records.
-- ============================================

select public.create_default_components(id)
from public.users;


-- ============================================
-- 12. VERIFY COMPONENTS
-- ============================================

select
    component_id,
    user_id,
    component_name,
    status
from public.components
order by user_id, component_name;


-- ============================================
-- 13. CHECK COMPONENT COUNT PER USER
-- ============================================

select
    user_id,
    count(*) as component_count
from public.components
group by user_id
order by user_id;