-- ============================================
-- ADLAWATT MONITORING TABLE
-- ============================================
-- Current real-time state of each user's
-- AdlaWatt system.
--
-- One user = one monitoring row.
--
-- monitor_id:
--   100
--   200
--   300
--   ...
--
-- ESP32 updates the existing row.
-- Frontend reads the current values.
--
-- Heartbeat is stored in THIS SAME TABLE:
--   last_seen
--
-- device_status:
--   Online  = recent ESP32 heartbeat
--   Offline = heartbeat expired / missing
--
-- No created_at.
-- No updated_at.
--
-- Realtime enabled.
-- RLS enabled.
-- ============================================


-- ============================================
-- 1. REMOVE OLD MONITORING DEPENDENCIES
-- ============================================

drop trigger if exists monitoring_updated_at
on public.monitoring;

drop trigger if exists on_public_user_created_monitoring
on public.users;

drop trigger if exists monitoring_heartbeat_trigger
on public.monitoring;


drop function if exists public.update_monitoring_timestamp();

drop function if exists public.handle_new_user_monitoring();

drop function if exists public.update_monitoring_from_hardware(
    bigint,
    numeric
);

drop function if exists public.update_monitoring_from_hardware(
    integer,
    numeric
);

drop function if exists public.send_esp32_heartbeat(
    bigint
);

drop function if exists public.check_esp32_heartbeat(
    bigint
);

drop function if exists public.check_esp32_heartbeats();


-- ============================================
-- 2. ADD HEARTBEAT COLUMN
-- ============================================
-- Keeps all existing monitoring columns.
--
-- NULL means no heartbeat has been received yet.
-- ============================================

alter table public.monitoring
add column if not exists last_seen timestamptz;


-- ============================================
-- 3. HEARTBEAT FUNCTION
-- ============================================
-- ESP32 calls this every 1 second.
--
-- It updates the SAME monitoring row:
--
--   device_status = Online
--   last_seen = current database time
--
-- monitor_id is selected by the hardware.
-- ============================================

create or replace function public.send_esp32_heartbeat(
    target_monitor_id bigint
)
returns boolean
language plpgsql
security definer
set search_path = public
as $$
begin

    update public.monitoring
    set
        device_status = 'Online',
        last_seen = now()
    where
        monitor_id = target_monitor_id;

    if not found then

        raise exception
            'Monitoring record not found.';

    end if;

    return true;

end;
$$;


-- ============================================
-- 4. ALLOW ESP32 TO CALL HEARTBEAT FUNCTION
-- ============================================

grant execute
on function public.send_esp32_heartbeat(bigint)
to anon;


-- ============================================
-- 5. OFFLINE CHECK FUNCTION
-- ============================================
-- Any device whose heartbeat is older than
-- 5 seconds becomes Offline.
--
-- This checks ALL monitoring rows.
-- ============================================

create or replace function public.check_esp32_heartbeats()
returns void
language plpgsql
security definer
set search_path = public
as $$
begin

    update public.monitoring
    set
        device_status = 'Offline'

    where
        (
            last_seen is null
            or last_seen <
                now() - interval '5 seconds'
        )

        and device_status <> 'Offline';

end;
$$;


-- ============================================
-- 6. PROTECT OFFLINE CHECK FUNCTION
-- ============================================

revoke execute
on function public.check_esp32_heartbeats()
from public, anon, authenticated;


-- ============================================
-- 7. ENABLE FULL REALTIME
-- ============================================

alter table public.monitoring
    replica identity full;


do $$
begin

    if not exists (
        select 1
        from pg_publication_tables
        where pubname = 'supabase_realtime'
          and schemaname = 'public'
          and tablename = 'monitoring'
    ) then

        alter publication supabase_realtime
        add table public.monitoring;

    end if;

end
$$;


-- ============================================
-- 8. ENABLE PG_CRON
-- ============================================
-- IMPORTANT:
-- pg_cron must be enabled in the Supabase
-- Dashboard before this section succeeds.
-- ============================================

create extension if not exists pg_cron;


-- ============================================
-- 9. REMOVE OLD HEARTBEAT CRON JOB
-- ============================================

select cron.unschedule(jobid)
from cron.job
where jobname =
    'adlawatt-monitoring-heartbeat-check';


-- ============================================
-- 10. SCHEDULE OFFLINE CHECK
-- ============================================
-- Runs every 1 second.
--
-- Recent heartbeat:
--     Online
--
-- No heartbeat for >5 seconds:
--     Offline
-- ============================================

select cron.schedule(
    'adlawatt-monitoring-heartbeat-check',
    '1 second',
    $$select public.check_esp32_heartbeats();$$
);


-- ============================================
-- 11. VERIFY MONITORING
-- ============================================

select
    monitor_id,
    user_id,
    battery_level,
    battery_status,
    time_remaining,
    solar_input,
    solar_status,
    current_load,
    device_status,
    last_seen,
    battery_temperature,
    battery_temperature_status
from public.monitoring
order by monitor_id;


-- ============================================
-- 12. VERIFY CRON JOB
-- ============================================

select
    jobid,
    jobname,
    schedule,
    command
from cron.job
where jobname =
    'adlawatt-monitoring-heartbeat-check';