// ============================================

// Voltage Sensor Signal -> GPIO 34
const int VOLTAGE_SENSOR_PIN = 34;

// Standard 0-25V voltage sensor divider
const float R1 = 30000.0;
const float R2 = 7500.0;

const float REF_VOLTAGE = 3.3;
const float ADC_MAX = 4095.0;

// ============================================
// Battery Configuration
// ============================================

// Working voltage range
const float BATTERY_MIN_VOLTAGE = 8.4;
const float BATTERY_MAX_VOLTAGE = 12.6;

// Battery protection settings
const float BATTERY_CAPACITY_AH = 60.0;

// 80% DoD means battery should retain 20%
const float DOD_LIMIT_PERCENT = 80.0;
const float MINIMUM_SOC_PERCENT = 20.0;

// ============================================
// Sampling Intervals
// ============================================

const unsigned long SAMPLE_INTERVAL = 500;
const unsigned long DATABASE_INTERVAL = 2000;

unsigned long previousSampleMillis = 0;
unsigned long previousDatabaseMillis = 0;

// ============================================
// Battery Voltage / SoC Table
// ============================================
//
// Based on the configured working range:
//
// 12.60V = 100%
// 12.18V = 90%
// 11.76V = 80%
// 11.34V = 70%
// 10.92V = 60%
// 10.50V = 50%
// 10.08V = 40%
//  9.66V = 30%
//  9.24V = 20%  <-- 80% DoD Threshold
//  8.82V = 10%
//  8.40V = 0%
// ============================================

struct VoltagePoint {
  float voltage;
  float soc;
};

const VoltagePoint SOC_TABLE[] = {

  {8.40,   0.0},
  {8.82,  10.0},
  {9.24,  20.0},
  {9.66,  30.0},
  {10.08, 40.0},
  {10.50, 50.0},
  {10.92, 60.0},
  {11.34, 70.0},
  {11.76, 80.0},
  {12.18, 90.0},
  {12.60, 100.0}

};

const int SOC_TABLE_SIZE =
  sizeof(SOC_TABLE) /
  sizeof(SOC_TABLE[0]);

// ============================================
// Current Readings
// ============================================

float currentVoltage = 0.0;
float currentBatteryLevel = 0.0;

// ============================================
// Read Battery Voltage
// ============================================

float readBatteryVoltage() {

  int adcValue =
    analogRead(VOLTAGE_SENSOR_PIN);

  float adcVoltage =
    (adcValue * REF_VOLTAGE) /
    ADC_MAX;

  float batteryVoltage =
    adcVoltage *
    ((R1 + R2) / R2);

  if (adcValue < 10) {
    batteryVoltage = 0.0;
  }

  return batteryVoltage;
}

// ============================================
// Voltage -> Battery Percentage
// ============================================

float voltageToBatteryLevel(float voltage) {

  // No voltage or below working range
  if (voltage <= BATTERY_MIN_VOLTAGE) {
    return 0.0;
  }

  // Fully charged
  if (voltage >= BATTERY_MAX_VOLTAGE) {
    return 100.0;
  }

  // Find the voltage range and interpolate
  for (
    int i = 0;
    i < SOC_TABLE_SIZE - 1;
    i++
  ) {

    float lowVoltage =
      SOC_TABLE[i].voltage;

    float highVoltage =
      SOC_TABLE[i + 1].voltage;

    if (
      voltage >= lowVoltage &&
      voltage <= highVoltage
    ) {

      float lowSOC =
        SOC_TABLE[i].soc;

      float highSOC =
        SOC_TABLE[i + 1].soc;

      float ratio =
        (voltage - lowVoltage) /
        (highVoltage - lowVoltage);

      return lowSOC +
        ratio * (highSOC - lowSOC);
    }
  }

  return 0.0;
}

// ============================================
// Calculate Battery Level
// ============================================

float calculateBatteryLevel(float voltage) {

  return voltageToBatteryLevel(voltage);

}

// ============================================
// Check 80% DoD Threshold
// ============================================

bool isDoDThresholdReached(
  float batteryLevel
) {

  return batteryLevel <= MINIMUM_SOC_PERCENT;

}

// ============================================
// Update Supabase
// ============================================

void updateBatteryLevel(
  float batteryLevel
) {

  if (WiFi.status() != WL_CONNECTED) {

    Serial.println(
      "Supabase skipped: WiFi disconnected."
    );

    return;
  }

  WiFiClientSecure client;
  client.setInsecure();

  HTTPClient http;

  String url =
    String(SUPABASE_URL) +
    "/rest/v1/monitoring" +
    "?monitor_id=eq." +
    String(MONITOR_ID);

  String json =
    "{\"battery_level\":" +
    String(batteryLevel, 2) +
    "}";

  if (!http.begin(client, url)) {

    Serial.println(
      "Failed to connect to Supabase."
    );

    return;
  }

  http.addHeader(
    "apikey",
    SUPABASE_KEY
  );

  http.addHeader(
    "Authorization",
    String("Bearer ") +
    SUPABASE_KEY
  );

  http.addHeader(
    "Content-Type",
    "application/json"
  );

  http.addHeader(
    "Prefer",
    "return=minimal"
  );

  int responseCode =
    http.PATCH(json);

  Serial.print("Supabase HTTP: ");
  Serial.println(responseCode);

  if (
    responseCode >= 200 &&
    responseCode < 300
  ) {

    Serial.println(
      "Battery level updated successfully."
    );

  } else {

    Serial.println(
      "Supabase update failed:"
    );

    Serial.println(
      http.getString()
    );
  }

  http.end();
}

// ============================================
// Sample Battery Voltage
// ============================================

void sampleVoltage() {

  currentVoltage =
    readBatteryVoltage();

  currentBatteryLevel =
    calculateBatteryLevel(
      currentVoltage
    );

  float currentDoD =
    100.0 - currentBatteryLevel;

  bool thresholdReached =
    isDoDThresholdReached(
      currentBatteryLevel
    );

  // ==========================================
  // Serial Monitor Display
  // ==========================================

  Serial.println();

  Serial.println(
    "======================================"
  );

  Serial.print(
    "Battery Voltage: "
  );

  Serial.print(
    currentVoltage,
    2
  );

  Serial.println(" V");

  Serial.print(
    "Battery Level: "
  );

  Serial.print(
    currentBatteryLevel,
    2
  );

  Serial.println("%");

  Serial.print(
    "Depth of Discharge: "
  );

  Serial.print(
    currentDoD,
    2
  );

  Serial.println("%");

  Serial.println(
    "--------------------------------------"
  );

  // ==========================================
  // 80% DoD Threshold Status
  // ==========================================

  if (thresholdReached) {

    Serial.println(
      "WARNING: 80% DoD THRESHOLD REACHED!"
    );

    Serial.print(
      "Remaining Battery: "
    );

    Serial.print(
      currentBatteryLevel,
      2
    );

    Serial.println("%");

    Serial.println(
      "Battery is at or below the 20% SoC limit."
    );

  } else {

    Serial.println(
      "Battery is within the safe 80% DoD range."
    );

    Serial.print(
      "Remaining Battery: "
    );

    Serial.print(
      currentBatteryLevel,
      2
    );

    Serial.println("%");

  }

  Serial.println(
    "======================================"
  );
}

// ============================================
// Setup
// ============================================

void setup() {

  Serial.begin(115200);

  delay(500);

  Serial.println();

  Serial.println(
    "======================================"
  );

  Serial.println(
    "AdlaWatt Battery Monitor Starting"
  );

  Serial.println(
    "======================================"
  );

  pinMode(
    VOLTAGE_SENSOR_PIN,
    INPUT
  );

  analogReadResolution(12);

  // Connect to WiFi

  WiFi.begin(
    WIFI_SSID,
    WIFI_PASSWORD
  );

  Serial.print(
    "Connecting to WiFi"
  );

  while (
    WiFi.status() != WL_CONNECTED
  ) {

    delay(500);

    Serial.print(".");
  }

  Serial.println();

  Serial.println(
    "WiFi connected."
  );

  Serial.print(
    "ESP32 IP Address: "
  );

  Serial.println(
    WiFi.localIP()
  );

  // Initial reading

  sampleVoltage();

  // Initial database update

  updateBatteryLevel(
    currentBatteryLevel
  );

  previousSampleMillis =
    millis();

  previousDatabaseMillis =
    millis();
}

// ============================================
// Main Loop
// ============================================

void loop() {

  unsigned long currentMillis =
    millis();

  // ==========================================
  // Sample Voltage
  // ==========================================

  if (
    currentMillis -
    previousSampleMillis >=
    SAMPLE_INTERVAL
  ) {

    previousSampleMillis =
      currentMillis;

    sampleVoltage();
  }

  // ==========================================
  // Update Supabase
  // ==========================================

  if (
    currentMillis -
    previousDatabaseMillis >=
    DATABASE_INTERVAL
  ) {

    previousDatabaseMillis =
      currentMillis;

    updateBatteryLevel(
      currentBatteryLevel
    );
  }
}
